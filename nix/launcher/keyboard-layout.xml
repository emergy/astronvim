<?xml version='1.0' encoding='utf-8'?>
<keyboard bottom_row="false" name="QWERTY — рабочая раскладка" script="latin">
  <row>
    <key c="q" ne="1" se="loc esc" />
    <key c="w" nw="~" ne="2" sw="\@" />
    <key c="e" nw="!" ne="3" sw="\#" n="loc €" />
    <key c="r" ne="4" sw="$" />
    <key c="t" ne="5" sw="%" />
    <key c="y" split_before="true" ne="6" sw="^" />
    <key c="u" ne="7" sw="&amp;" />
    <key c="i" ne="8" sw="*" />
    <key c="o" ne="9" sw="(" se=")" />
    <key c="p" ne="0" sw=":keyevent flags='small' symbol='F7':137" se=":keyevent flags='small' symbol='F8':138" />
  </row>
  <row>
    <key shift="0.5" c="a" ne="`" sw="tab" />
    <key c="s" ne="tool:session.next:›" sw="tool:session.new:+" nw="tool:session.previous:‹" />
    <key c="d" ne="^d:ctrl,d" />
    <key c="f" ne="-" sw="_" />
    <key c="g" ne="=" sw="+" />
    <key c="h" split_before="true" sw="&lt;" se="&gt;" />
    <key c="j" sw="{" se="}" ne="&quot;" />
    <key c="k" sw="[" se="]" ne="'" />
    <key c="l" ne="|" sw="\\" />
  </row>
  <row>
    <key width="1.5" c="shift" ne="loc capslock" sw="switch_backward" />
    <key c="z" ne="⌥z:alt,z" />
    <key c="x" ne="loc †" />
    <key c="c" ne="^c:ctrl,c" />
    <key c="v" />
    <key c="b" split_before="true" ne="\?" sw="/" />
    <key c="n" ne=":" sw=";" />
    <key c="m" sw="," se="." />
    <key width="1.5" c="backspace" ne="delete" />
  </row>
  <row height="0.95">
    <key width="1.7" c="ctrl" ne="tool:app.command_palette:󱎱" sw="loc switch_clipboard" se="switch_numeric" n="loc meta" />
    <key width="1.3" c="loc alt" nw="fn" ne="loc change_method" se="config" />
    <key width="4.0" c="space" split_at="2.5" w="cursor_left" e="cursor_right" s="cursor_down" n="cursor_up" nw="tool:window.previous:󰜳" ne="tool:window.next:󰜶" sw="tool:session.previous:󰜹" se="tool:session.next:󰜰" />
    <key width="1.3" c="loc compose" nw="home" ne="page_up" sw="page_down" se="end" w="left" e="right" n="up" s="down" />
    <key width="1.7" c="enter" n="voice_typing" s="^↵:ctrl,enter" />
  </row>
  <modmap>
    <fn a="q" b="f1" />
    <fn a="w" b="f2" />
    <fn a="e" b="f3" />
    <fn a="r" b="f4" />
    <fn a="t" b="f5" />
    <fn a="y" b="f6" />
    <fn a="u" b="f7" />
    <fn a="i" b="f8" />
    <fn a="o" b="f9" />
    <fn a="p" b="f10" />
    <fn a="a" b="esc" />
    <fn a="s" b="tab" />
    <fn a="d" b="home" />
    <fn a="f" b="up" />
    <fn a="g" b="end" />
    <fn a="h" b="page_up" />
    <fn a="j" b="left" />
    <fn a="k" b="down" />
    <fn a="l" b="right" />
    <fn a="z" b="f11" />
    <fn a="x" b="f12" />
    <fn a="c" b="insert" />
    <fn a="v" b="delete" />
    <fn a="b" b="page_down" />
    <fn a="n" b="^c:ctrl,c" />
    <fn a="m" b="^d:ctrl,d" />
  </modmap>
</keyboard>