. "$HOME/.config/workstation/shell-env.sh"
case $- in
  *i*) ;;
  *) return ;;
esac
export HISTSIZE=100000 HISTFILESIZE=100000
shopt -s histappend
if [ -r "$HOME/.termux/shell-integration/termux-launcher.bash" ]; then
  . "$HOME/.termux/shell-integration/termux-launcher.bash"
fi
start-sshd

. "$HOME/.config/workstation/interactive-shell.sh"
if [ -r "$HOME/.config/nvim/terminal/autostart.bash" ]; then
  . "$HOME/.config/nvim/terminal/autostart.bash"
fi
